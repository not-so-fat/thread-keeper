{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thread-keeper.local/contracts/event.json",
  "title": "event",
  "description": "Normalized parser output (pre-DB); seq assigned on insert.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "uuid": { "type": ["string", "null"] },
    "ts": { "type": ["string", "null"] },
    "kind": { "enum": ["user", "assistant", "thinking", "tool_use", "tool_result"] },
    "text": { "type": ["string", "null"] },
    "tool_name": { "type": ["string", "null"] },
    "tool_input": { "type": ["string", "null"], "description": "JSON-encoded string" },
    "tool_use_id": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] }
  }
}
